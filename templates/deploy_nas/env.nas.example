# ==============================================================================
# NAS Docker 專案環境變數範例檔
# 說明：
# 1. 將本檔發布至 NAS 後，於專案根目錄複製並命名為 `.env`。
# 2. 這裡僅存放專案運行所需之組態與連線設定，請勿填入未經遮罩之明文金鑰。
# ==============================================================================

# 伺服器監聽設定
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO

# 特殊模式開關（若專案採反向中繼架構，請開啟開關；直連模式保持 false）
# RELAY_MODE=false
# OFFLINE_MOCK=false

# 內部 API / 資料庫連線設定範例
# DB_SERVER=<DB_HOST_OR_IP>
# DB_NAME=<DATABASE_NAME>
# API_ENDPOINT=http://<TARGET_HOST>:<PORT>/api
# VERIFY_SSL=false
